{
  "name": "jev-model-router-for-claude",
  "version": "0.3.0",
  "description": "Runs Claude Code and routes each turn to the cheapest sufficient model using TypeSafe Jev through an OpenRouter API key",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jozso39/jev-model-router-for-claude.git"
  },
  "homepage": "https://github.com/jozso39/jev-model-router-for-claude#readme",
  "bugs": "https://github.com/jozso39/jev-model-router-for-claude/issues",
  "bin": {
    "jev-claude": "bin/jev-claude.mjs",
    "jev-codex": "bin/jev-codex.mjs",
    "jev-explain": "bin/jev-explain.mjs",
    "jev-proxy": "bin/jev-proxy.mjs"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
